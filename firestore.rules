rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only these two accounts can read or change your household. Use lowercase emails.
    match /households/{householdId} {
      allow read, write: if request.auth != null
        && request.auth.token.email.lower() in ['YOUR_EMAIL@example.com', 'SABRINA_EMAIL@example.com'];
    }
    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
